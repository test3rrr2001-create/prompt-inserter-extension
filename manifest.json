{
  "manifest_version": 3,
  "name": "Prompt Inserter MVP",
  "version": "0.3.2",
  "version_name": "0.3.2-auto-close",
  "description": "Insert prompts into Gemini, ChatGPT, and Claude with prefill variable modal support.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://gemini.google.com/*",
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://claude.ai/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Prompt Inserter"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "prompts.md",
        "prompt_meta.json"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
